{
  "name": "root",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
    "check-package": "turbo check-package",
    "clean": "turbo clean",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,js,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,js,json,css,md}\""
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.5"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint": "10"
      }
    }
  }
}
